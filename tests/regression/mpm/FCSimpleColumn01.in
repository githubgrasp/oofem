FCSimpleColumn.out
Test of mpm upline11 element
# final time 500, initial time step 1 
mpmproblem nsteps 500 deltat 1.0 alpha 0.5 nmodules 1 manrmsteps 0 keeptangent
#vtkxml tstep_all domain_all primvars 2 1 5
errorcheck
domain HeatTransfer
outputmanager tstep_all dofman_all element_all
ndofman 5 nelem 4 nbc 3 ncrosssect 1 nic 0 nltf 2 nmat 1 nset 5
node 1 coords 1 0.00100000005
node 2 coords 1 0.000750000007
node 3 coords 1 0.000500000024
node 4 coords 1 0.000250000012
node 5 coords 1           0.
#
upline11 1 nodes 2 1 2
upline11 2 nodes 2 2 3
upline11 3 nodes 2 3 4 
upline11 4 nodes 2 4 5 
#
dummycs 1 mat 1 set 1
# ks = inifinity, kw=1e+09
# 1/Q = n/Kt+(b-n)/Ks = 0.3333/1.e9+(1-0.3333)/inf = 3.333333e-10
#  The porosity (n) and the void ratio (e) are inter-related as follows: n = e / (1+e), n=0.5/(1+0.5)= 0.333
upm 1 d 1.0 e 1e7 nu 0.3 k 1.e-15 c 3.33333333e-10 alpha 1.0
#
boundarycondition 1 loadtimefunction 1 set 4 values 1 0   dofs 1 1 
# pressure top (bleeding=pressure set to zero?)
boundarycondition 2 loadtimefunction 1 set 5 values 1 0.0 dofs 1 11 
# pressure load top p=1, Fi=p*a/4 = 1*(0.0001*0.0001)/4 = 2.5e-09
nodalload 3 loadtimefunction 2 dofs 1 1 Components 1 1 set 5
#
#
constantfunction 1 f(t) 1
PiecewiseLinFunction 2 nPoints 4 t 4 -10. 0. 100. 500. f(t) 4 0. 0. 1000000.0 1000000.0 
set 1 elements 4 1 2 3 4
set 2 
set 3 
# z-bc
set 4 nodes 1 4
# top surface (load + )
set 5 nodes 1 1 
#%BEGIN_CHECK%
#TIME
#NODE tStep 100 number 1 dof 1 unknown d value 4.83986514e-05 tolerance 1.e-10
#NODE tStep 100 number 4 dof 11 unknown d value -2.01586797e+05 tolerance 1.
#NODE tStep 500 number 1 dof 1 unknown d value 5.57142802e-05 tolerance 1.e-10
#NODE tStep 500 number 4 dof 11 unknown d value -2.68785947e-01 tolerance 1.e-5
#%END_CHECK%
